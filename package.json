{
  "name": "nanstar-note",
  "version": "1.0.0",
  "description": "NanStar Note is a lightweight personal note platform for technical notes, client-site quick lookup, and browser-based access.",
  "main": "electron.js",
  "scripts": {
    "cap": "npx @capacitor/cli",
    "cap:init": "npx @capacitor/cli init \"NanStar Note\" \"com.nanstar.note\" --web-dir=.",
    "cap:add:android": "npx @capacitor/cli add android",
    "cap:sync": "npx @capacitor/cli sync",
    "electron:start": "electron .",
    "electron:build": "electron-builder",
    "serve": "npx serve ."
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ggbondgh/nanstar-note.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/ggbondgh/nanstar-note/issues"
  },
  "homepage": "https://github.com/ggbondgh/nanstar-note#readme",
  "dependencies": {
    "puppeteer": "^25.2.1"
  },
  "devDependencies": {
    "@capacitor/android": "^8.4.1",
    "@capacitor/cli": "^8.4.1",
    "@capacitor/core": "^8.4.1",
    "electron": "^43.0.0",
    "electron-builder": "^26.15.3"
  }
}
